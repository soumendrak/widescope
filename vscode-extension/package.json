{
  "name": "vscode-widescope",
  "displayName": "WideScope — LLM Trace Viewer",
  "description": "Open LLM/agent trace JSON files in the WideScope viewer without leaving VS Code.",
  "version": "0.1.0",
  "publisher": "soumendrak",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/soumendrak/widescope" },
  "engines": { "vscode": "^1.84.0" },
  "categories": ["Visualization", "Debuggers"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "widescope.viewTrace",
        "title": "WideScope: View trace file"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "widescope.viewTrace",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "widescope.viewTrace",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ]
    }
  }
}
