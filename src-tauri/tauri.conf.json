{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WideScope",
  "version": "0.1.0",
  "identifier": "com.soumendrak.widescope",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ui && npm run dev",
    "beforeBuildCommand": "cd ui && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WideScope",
        "url": "editor/index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["json", "trace"],
        "name": "Trace File",
        "description": "WideScope trace file",
        "role": "Viewer"
      }
    ]
  }
}
